{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Team Task Artifact Manifest",
  "type": "object",
  "required": ["task_id", "manifest_version", "artifacts"],
  "properties": {
    "task_id": { "type": "string", "pattern": "^[A-Z0-9]+-[0-9]{3,}$" },
    "manifest_version": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "role", "sha256", "size_bytes"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["input", "baseline", "candidate", "evidence", "report", "other"] },
          "version": { "type": ["string", "null"] },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "media_type": { "type": ["string", "null"] },
          "source": { "type": ["string", "null"] },
          "parent_artifact_id": { "type": ["string", "null"] },
          "verification": { "type": "string", "enum": ["not_checked", "hash_verified", "content_inspected", "independently_reproduced"] },
          "notes": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}