{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Xen AI Agent Handoff",
  "type": "object",
  "required": ["task_id", "version", "from", "to", "status", "deliverables", "next_action"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[A-Z0-9]+-[0-9]{3,}$"},
    "version": {"type": "string"},
    "from": {"type": "string", "enum": ["director", "orchestrator", "designer", "programmer", "reviewer"]},
    "to": {"type": "string", "enum": ["director", "orchestrator", "designer", "programmer", "reviewer"]},
    "status": {"type": "string", "enum": ["draft", "ready", "blocked", "needs_changes", "pass", "insufficient_evidence", "accepted"]},
    "deliverables": {"type": "array", "items": {"type": "string"}},
    "required_inputs": {"type": "array", "items": {"type": "string"}},
    "director_approval": {"type": ["string", "null"]},
    "next_action": {"type": "string"},
    "open_questions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
